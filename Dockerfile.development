# Debian 12. Antes: node:18.17.1-bullseye-slim, pero bullseye quedó EOL y
# deb.debian.org dejó de servir los .deb de bullseye-security (404 en todo el
# pool), así que `apt-get upgrade` rompía el build con exit 100.
FROM node:18.17.1-bookworm-slim

LABEL maintainer = "gmunoz@osacontrol.com"

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cabextract \
        wget \
        gnupg \
        chromium fonts-ipafont-gothic fonts-wqy-zenhei fonts-thai-tlwg fonts-khmeros fonts-kacst fonts-freefont-ttf libxss1 \
        xfonts-utils \
        ca-certificates \
        fontconfig \
        libfreetype6 \
        libfreetype6-dev \
        libfontconfig1 \
        libfontconfig1-dev \
        libssl-dev \
        libxft-dev \
        python \
        python3 \
        graphicsmagick \
        gettext \
        git \
        imagemagick && \
    # install windows fonts
    wget http://ftp.br.debian.org/debian/pool/contrib/m/msttcorefonts/ttf-mscorefonts-installer_3.8_all.deb && \
    dpkg -i ttf-mscorefonts-installer_3.8_all.deb && \
    rm ttf-mscorefonts-installer_3.8_all.deb && \
    fc-cache && \
    # clean
    apt-get clean && \
    rm -rf /var/lib/apt

# # We don't need the standalone Chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD true
ENV PUPPETEER_EXECUTABLE_PATH /usr/bin/chromium

WORKDIR /srv

RUN npm install -g npm@10.9.2

RUN npm i -g typescript ts-node ts-node-dev ts-migrate-mongoose
RUN touch /srv/s3-config.json
RUN echo "{}" >> /srv/s3-config.json
RUN touch /srv/ses-config.json
RUN echo "{}" >> /srv/ses-config.json

COPY ./package.json /srv/package.json

RUN export PYTHON=python3
RUN npm i && npm cache clean --force

EXPOSE 3000

