# Debian 12. Antes: node:18.17.1-bullseye-slim, pero bullseye quedó EOL y
# deb.debian.org dejó de servir los .deb de bullseye-security (404 en todo el
# pool), así que `apt-get upgrade` rompía el build con exit 100.
FROM node:18.17.1-bookworm-slim

LABEL maintainer="gmunoz@osacontrol.com"

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cabextract \
        wget \
        gnupg \
        chromium fonts-ipafont-gothic fonts-wqy-zenhei fonts-thai-tlwg fonts-khmeros fonts-kacst fonts-freefont-ttf libxss1 \
        xfonts-utils \
        ca-certificates \
        fontconfig \
        libfreetype6 \
        libfontconfig1 \
        libssl-dev \
        libxft-dev \
        python3 \
        nano \
        graphicsmagick \
        gettext \
        git \
        imagemagick && \
    # install windows fonts
    wget http://ftp.br.debian.org/debian/pool/contrib/m/msttcorefonts/ttf-mscorefonts-installer_3.8_all.deb && \
    dpkg -i ttf-mscorefonts-installer_3.8_all.deb && \
    rm ttf-mscorefonts-installer_3.8_all.deb && \
    fc-cache && \
    # clean
    apt-get clean && \
    rm -rf /var/lib/apt

# # We don't need the standalone Chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /scripts

RUN rm -rf /scripts/node_modules

RUN npm install -g npm@10.9.2

RUN npm i -g typescript@4.9.4 ts-node ts-node-dev ts-migrate-mongoose

COPY package.json /scripts/
COPY package-lock.json /scripts/
COPY tsconfig.json /scripts/

# Copy everything the billing entrypoint imports transitively.
# This is broader than strictly necessary, but keeps the image self-contained
# and avoids hunting for missing files on every change.
COPY ./src /scripts/src
COPY ./views /scripts/views

# AWS RDS / DocumentDB root CA bundle. Read at runtime via MONGO_TLS_CA_FILE.
COPY ./global-bundle.pem /scripts/global-bundle.pem
ENV MONGO_TLS_CA_FILE=/scripts/global-bundle.pem

ENV PYTHON=python3

RUN npm i --save-dev @types/bluebird @types/multer
RUN npm i

# CMD uses ts-node --transpile-only to skip type-checking at startup.
# Type errors elsewhere in the codebase (e.g. inventory.controller.ts paginate
# typing, missing @google/generative-ai types) would otherwise block boot.
CMD ["ts-node", "--transpile-only", "src/app/commands/BillingTeamRun.ts"]
