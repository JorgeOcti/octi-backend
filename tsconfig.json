{
  "compilerOptions": {
    "incremental": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "esnext",
    "baseUrl": "src",
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "dist",
    "tsBuildInfoFile": "./buildcache/buildcache",
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "noImplicitThis": false,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types/",
      "../../node_modules/@types/",
      "./src/@types",
      "../src/@types",
      "../../src/@types",
      "../../../src/@types",
      "../../../../src/@types"
    ]
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "views",
    "logs",
    "node_modules",
    "dist",
    "public",
    "email-templates"
  ]
}
