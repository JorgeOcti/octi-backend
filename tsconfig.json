{
  "compilerOptions": {
    /* Basic Options */
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "esnext",
    "baseUrl": "src",
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "dist/",
     /* Strict Type-Checking Options */
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "noImplicitThis": false,
    "strictNullChecks": true,
    /* Additional Checks */
    "noUnusedLocals": true
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "views",
    "logs",
    "node_modules",
    "dist"
  ]
}
