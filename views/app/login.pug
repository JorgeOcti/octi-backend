    link(rel='shortcut icon', href='/static/images/favicon-osa.ico')
    meta(http-equiv='X-UA-Compatible', content='IE=edge')
    meta(name='author' property='og:author' content='OSA S.A')
    meta(name='image' property='og:image' content='https://s3-sa-east-1.amazonaws.com/mediaosa/osa_andes_share.jpg')
    title Iniciar sesión ‧ OSA Andes
    meta(name='robots' content='index,follow')
    meta(name='description' content='¿Dónde y cómo se producen tus daños? ¿Cuán disponible está tu stock?  No sólo visibilizamos los datos con velocidad. Los entregamos de manera sencilla para que puedas gestionar y resolver.')
    meta(name='twitter:card' content='summary_large_image')
    meta(name='twitter:site' content='@osacontrol')
    meta(name='twitter:creator' content='@handle')
    meta(property='og:title' content='Iniciar sesión ‧ OSA Andes')
    meta(property='og:description' content='¿Dónde y cómo se producen tus daños? ¿Cuán disponible está tu stock?  No sólo visibilizamos los datos con velocidad. Los entregamos de manera sencilla para que puedas gestionar y resolver')
    meta(property='og:url' content='https://andes.osacontrol.com/account/login/')
    meta(property='og:type' content='page')
    meta(property='og:site_name' content='OsaControl')
    link(rel='canonical' href='https://andes.osacontrol.com/')


    //- Tell the browser to be responsive to screen width
    meta(content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no', name='viewport')
    //- Bootstrap 3.3.7
    link(rel='stylesheet', href=`/static${getVersionedPath('/css/vendor/bootstrap/bootstrap.min.css')}`)
    //- Font Awesome
    link(rel='stylesheet', href=`/static${getVersionedPath('/css/vendor/font-awesome/font-awesome.min.css')}`)
    //- Google Font
    link(rel='stylesheet', href='https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic')
    <!--[if lt IE 9]>
    script(src='https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js')
    script(src='https://oss.maxcdn.com/respond/1.4.2/respond.min.js')
    <![endif]-->
    link(rel='stylesheet', href=`/static${getVersionedPath('/css/style.css')}`)
    title OSA Andes | Iniciar sesión
    //- html,body{overflow-y:hidden;overflow-x:hidden}body{background:linear-gradient(to left, #A34E69, #90354D);color:#FFF;}
    style
      | html,body{background:linear-gradient(to left, #a1214c, #8c1d42);overflow-y:hidden;overflow-x:hidden}body{color:#FFF;overflow-y:hidden;}

  body
    #login-container
      .row
        .col-md-4
        .col-md-4
          .login
            p.text-center
              img(src=`/static${getVersionedPath('/images/OSA_andes_logo.svg')}`, class='text-center logo')
            if error
              p.text-center.text-red=error
            form(role='form', action=`/account/login/`, method="post")
              //input(type='hidden', name='_csrf', value=csrfToken)
              .form-group
                .input-group
                  .input-group-addon
                    i.fa.fa-user
                  input#username.form-control(type='text', placeholder='e-mail', name='username', autocomplete='off' value=username)
              .form-group
                .input-group
                  .input-group-addon
                    i.fa.fa-lock
                  input#password.form-control(type='password', placeholder='contraseña', name='password', autocomplete='off')
              .form-group.text-right
                a(href='/account/forgot-password/', class='forget-password') ¿Olvidó su contraseña?
              .form-group
                button.btn.btn-block.btn-primary(type='submit', style='margin-right:3px')='Iniciar sesión'
        .col-md-4
    #login-footer.text-center
      | Copyright (c) #{moment().format('YYYY')} OSA SPA. Todos los derechos reservados.
    .js
      //- polyfill.io
      //- script(src='https://cdn.polyfill.io/v2/polyfill.min.js')
      //- jQuery 3
      script(src=`/static${getVersionedPath('/js/vendor/jquery/jquery.min.js')}`)
      //- Bootstrap 3.3.7
      script(src=`/static${getVersionedPath('/js/vendor/bootstrap/bootstrap.min.js')}`)
