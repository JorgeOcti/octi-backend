doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0')
    link(rel='shortcut icon', href='/static/images/favicon-octimize.ico')
    meta(http-equiv='X-UA-Compatible', content='IE=edge')
    meta(name='author' property='og:author' content='Octimize SpA')
    title Restablecer contraseña ‧ Octimize
    meta(name='robots' content='index,follow')
    meta(name='description' content='¿Dónde y cómo se producen tus daños? ¿Cuán disponible está tu stock?  No sólo visibilizamos los datos con velocidad. Los entregamos de manera sencilla para que puedas gestionar y resolver')
    meta(name='twitter:card' content='summary_large_image')
    meta(name='twitter:site' content='@octimize')
    meta(name='twitter:creator' content='@octimize')
    meta(property='og:title' content='Restablecer contraseña ‧ Octimize')
    meta(property='og:description' content='¿Dónde y cómo se producen tus daños? ¿Cuán disponible está tu stock?  No sólo visibilizamos los datos con velocidad. Los entregamos de manera sencilla para que puedas gestionar y resolver')
    meta(property='og:url' content='https://octi.octimize.cl/account/forgot-password/')
    meta(property='og:type' content='page')
    meta(property='og:site_name' content='Octimize')
    link(rel='canonical' href='https://octi.octimize.cl/')
    //- Bootstrap 3.3.7
    link(rel='stylesheet', href=`/static${getVersionedPath('/css/vendor/bootstrap/bootstrap.min.css')}`)
    //- Font Awesome
    link(rel='stylesheet', href=`/static${getVersionedPath('/css/vendor/font-awesome/font-awesome.min.css')}`)
    //- Google Font
    link(rel='stylesheet', href='https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic')
    <!--[if lt IE 9]>
    script(src='https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js')
    script(src='https://oss.maxcdn.com/respond/1.4.2/respond.min.js')
    <![endif]-->
    link(rel='stylesheet', href=`/static${getVersionedPath('/css/style.css')}`)
    //- html,body{overflow-y:hidden;overflow-x:hidden}body{background:linear-gradient(to left, #A34E69, #90354D);color:#FFF;}
    style
      | html,body{background:url('/static/images/bg_login_purple.svg') center/cover no-repeat, #342040;overflow-y:hidden;overflow-x:hidden}body{color:#FFF;overflow-y:hidden;}

  body
    #login-container
      if post
        .row
          .col-md-4
          .col-md-4
            .login
              p.text-center
                img(src=`/static${getVersionedPath('/images/octimize_logo.svg')}`, class='text-center logo')
              p.text-center
                | Hemos enviado un correo electrónico con un enlace para que restaures el acceso a tu cuenta.
              form
                .form-group
                  a.btn.btn-block.btn-primary(style='margin-right:3px' href="/account/login/")='Aceptar'
      else
        .row
          .col-md-4
          .col-md-4
            .login
              p.text-center
                img(src=`/static${getVersionedPath('/images/octimize_logo.svg')}`, class='text-center logo')
              form(role='form', action='', method="post")
                input(type='hidden', name='_csrf', value=csrfToken)
                p.text-center
                  | Ingresa tu correo electrónico y te enviaremos un enlace para que restaures el acceso a tu cuenta.
                .form-group
                  .input-group
                    .input-group-addon
                      i.fa.fa-user
                    input#username.form-control(type='text', placeholder='e-mail', name='username', autocomplete='off')
                .form-group
                  button.btn.btn-block.btn-primary(type='submit', style='margin-right:3px')='Enviar correo'
          .col-md-4
    #login-footer.text-center
      | Copyright (c) #{moment().format('YYYY')} Octimize SpA. Todos los derechos reservados.
    .js
      //- polyfill.io
      script(src='https://cdn.polyfill.io/v2/polyfill.min.js')
      //- jQuery 3
      script(src=`/static${getVersionedPath('/js/vendor/jquery/jquery.min.js')}`)
      //- Bootstrap 3.3.7
      script(src=`/static${getVersionedPath('/js/vendor/bootstrap/bootstrap.min.js')}`)
