extends ../layout

block head
  title OSA Andes

block content
   #app.wrapper

block js
  //- AdminLTE App
  script(src=`/static${getVersionedPath('/theme/dist/js/adminlte.min.js')}`)
  //- xlsx
  script(src=`/static${getVersionedPath('/js/vendor/xlsx/shim.min.js')}`)
  script(src=`/static${getVersionedPath('/js/vendor/xlsx/xlsx.full.min.js')}`)
  //- chosen
  script(src=`/static${getVersionedPath('/js/vendor/chosen/chosen.min.js')}`)
  link(rel='stylesheet', href=`/static${getVersionedPath('/css/vendor/chosen/chosen.min.css')}`)
  script.
    window.user = {_id: '!{`${user.id}`}', firstName: '!{`${user.firstName}`}', lastName: '!{`${user.lastName}`}', email: '!{`${user.email}`}', company: '!{`${user.company._id}`}', venuesAccess: !{`${JSON.stringify(user.venuesPermissions())}`}, team: '!{`${user.team}`}', userPermissions: !{`${JSON.stringify(user.userPermissions.toObject())}`}, token: '!{`${token}`}'};
  //- React App
  //- bostrap-select
  //- script(src=`/static${getVersionedPath('/js/vendor/bootstrap-select/bootstrap-select.min.js')}`)
  //- bootstrap-select
  link(rel='stylesheet', href=`/static${getVersionedPath('/css/vendor/bootstrap-select/bootstrap-select.min.css')}`)
  script(src = `/static${getVersionedPath('/js/app/dist/main.bundle.js')}`)
  script(src = `/static${getVersionedPath('/js/app/dist/vendors~main.bundle.js')}`)
