mixin headerDetail(first, second, third, quarter)
  tr
    td(width="18%", class="strong")=first
    if second
      td(width="32%")=second
    else
      td(width="32%")
        .border-bottom-dashed
    if third
      td(width="12%", class="strong")=third
      if quarter
        td(width="38%")=quarter
      else
        td(width="38%")
          .border-bottom-dashed

mixin headerDetailRight(first, second, third, quarter)
  tr
    td(width="18%", class="strong")=first
    if second
      td(width="32%")=second
    else
      td(width="32%")
        .border-bottom-dashed
    if third
      td(width="12%", class="strong")=third
      if quarter
        td(width="38%").text-right=quarter
      else
        td(width="38%").text-right
          .border-bottom-dashed

mixin carDetail(first, second, third, quarter, fifth, sixth)
  tr
    td(width="8%", class="strong")=first
    if second
      td(width="25.3%")=second
    else
      td(width="25.3%")
        .border-bottom-dashed
    if third
      td(width="8%", class="strong")=third
      if quarter
        td(width="25.3%")=quarter
      else
        td(width="25.3%")
          .border-bottom-dashed
    if fifth
      td(width="8%", class="strong")=fifth
      if sixth
        td(width="25.3%")=sixth
      else
        td(width="25.3%")
          .border-bottom-dashed

doctype html
head
  title OSA Andes
  meta(charset='utf8')
  meta(content='text/html; charset=utf-8', http-equiv='Content-Type')
  link(rel='stylesheet' href='https://use.fontawesome.com/releases/v5.8.1/css/all.css' integrity='sha384-50oBUHEmvpQ+1lW4y57PTFmhCaXp0ML5d60M1M7uH2+nqUivzIebhndOJK28anvf' crossorigin='anonymous')
  style(type='text/css')=css
body
  table(cellpadding='0', cellspacing='0' style="margin-bottom:0;padding-bottom:0")
    tr
      td(width="80%")
        if logo
          img(src=logo, height="60px")
      td(width="20%")
        .text-right
          img(src=qr, height="60px")

  table(cellpadding='0', cellspacing='0')
    tr
      td(colspan=4, class="middle-center strong", style="font-size:10px;padding-bottom:10px")=participant.name
    +headerDetailRight('Nº TRASLADO', participant.number, 'FECHA', moment(participant.createdAt).format('LLL'))
    +headerDetail('ENCARGADO', `${participant.user.firstName} ${participant.user.lastName}`)
    +headerDetail('ORIGEN', origin(), 'DESTINO', destination())
    +headerDetail('E. TRANSPORTADORA', carrier(), false, false)

  table(cellpadding='0', cellspacing='0', class="border")
    tr
      td(colspan=6, class="strong")="DETALLES DE LA UNIDAD"
    +carDetail('CHASIS', participant.car.vin, 'MARCA', participant.car.brand, 'MODELO', participant.car.denomination)
    +carDetail('COLOR', participant.car.color, participant.car.patent ? 'PATENTE': false, participant.car.patent ? participant.car.patent: false, participant.car.engineNumber ? 'MOTOR': false, participant.car.engineNumber ? participant.car.engineNumber: false)

  table(cellpadding='0', cellspacing='0', class="border")
    each section in participant.sections
      tr.heading
        td=section.name
        td(width="20%", class="text-center")
          | Respuesta
        td(width="10%", class="text-center")
          | Evidencia
      each answer in section.answers
        tr.item
          td
            p.no-margin.strong=answer.question
          if ['scale', 'accessory'].includes(answer.kind) && answer.scale
            td.text-center=getAnswer(answer.scale, answer)
          else
            td
          td.text-center
            if answer.kind === 'scale' && answer.scale
              if answer.images.length
                | Si
              else
                | No
        if answer.kind === 'accessory' && requireAccesory(answer.scale, answer)
          tr
            td(colspan=3, style="padding-bottom:0px").text-center
              strong=answer.accessories.question
          tr.item
            td(colspan=3, style="padding-top:0px")
              - const accesorySeletedIds = answer.accesoriesAnswered?answer.accesoriesAnswered.map(accesory=>accesory.item):[];
              - const items = answer.accessories.items.filter((item)=>accesorySeletedIds.includes(item._id.toString()));
              if items.length
                table(cellpadding='0', cellspacing='0', style="margin-bottom:0;padding-bottom:0")
                  while items.length
                    tr
                      each item in items.splice(0,4)
                        td(style="padding:4px 0", width="25%").no-border-bottom
                          - const accesory = accesorySelected(answer, item);
                          | #{'- '}#{item.item} #{accesory && item.amount ? `(${accesory.amount})` : ''}
                          //- if accesory
                          //-   | <i class="far fa-check-square"></i>
                          //- else
                          //-   | <i class="far fa-square"></i>
              else
                tr.item-damage
                  td(colspan=2)
                    | No se seleccionaron items.
        if answer.kind === 'damage'
          if !answer.damagesSelected.length
            tr.item-damage
              td(colspan=2)
                | No se encontraron daños
          else
            each ds in answer.damagesSelected
              tr.item-damage
                td(colspan=2)
                  table(class='damage-table', cellpadding='0', cellspacing='0', style="margin-bottom:0;padding-bottom:0")
                    tr
                      td
                        strong=getDamageItem(answer.damages.parts, ds.part)
                    tr
                      td
                        strong Daño:
                        | #{' ' + getDamageItem(answer.damages.kinds, ds.kind) + ' '}
                        strong Posición:
                        | #{' ' +getDamageItem(answer.damages.positions, ds.position)}
                td(class="text-center")
                  if ds.images.length
                    | Si
                  else
                    | No
        if answer.comment
          tr.item
            td(colspan=3, style="padding: 0 5px")
              table(cellpadding='0', cellspacing='0', style="margin-bottom:0;padding-bottom:0")
                tr
                  td.no-border-bottom
                    strong(style="color:#6B6B6B") Comentario:
                    | #{' ' + answer.comment}


  table(cellpadding='0', cellspacing='0' style="margin-top:40px")
    tr
      td(width="40%", class="border-top-solid text-center strong")
        | Firma encargado
      td(width="20%")
      td(width="40%", class="border-top-solid text-center strong")
        | Firma transportador

sections = participant.sections.filter(section => section.answers.length > 0);
each section in sections
  - const selectChoice = section.answers.find(answer => answer.kind === 'select-choice');
  - const items = selectChoice ? selectChoice.items : [];
  - const parts = selectChoice ? selectChoice.parts : {};
  - const kinds = selectChoice ? selectChoice.kinds : {};
  - const positions = selectChoice ? selectChoice.positions : {};

 
  //- Este bloque debe ir dentro de un each section in sections
  .section
    h4 #{section.order} #{section.name} 
      small #{Math.round(saction.qualification)}%
    .question
      p
        strong
          | #{section.order}.#{index + 1} #{answer.question} 
          if !answer.optional
            span.red.text-bold *
        if answer.hint
          small.text-muted.text-sm
            br
            | #{answer.hint}

      if answer.scale
        .flex(style="padding:5px")
          each choice in answer.scale.choices
            - const isSelected = choice._id === answer.answer
            - const btnClass = {
            -   blue: 'btn-primary',
            -   green: 'btn-success',
            -   yellow: 'btn-warning',
            -   red: 'btn-danger'
            - }[choice.backgroundColor] || 'btn-default';
            button.btn.flex-row-item.text-wrap(class=isSelected ? btnClass : 'btn-default', style="margin:2px", disabled)
              | #{choice.choice}

      if answer.damagesSelected && answer.damagesSelected.length
        .row(style="margin-top:10px")
          each ds in answer.damagesSelected
            .col-md-12.damage
              .damage-detail
                p.damage-description
                  strong.title #{parts[ds.part] || '-'}
                  br
                  strong Daño 
                  span.text-primary #{kinds[ds.kind] || '-'}
                  strong Posición 
                  span.text-primary #{positions[ds.position] || '-'}
                  if answer.requireSeverity && ds.severity
                    strong Severidad 
                    | #{ds.severity}
                if ds.images.length
                  .row.images
                    each image in ds.images
                      .col-md-3.col-sm-4.col-xs-4.text-center
                        a.zoom-in(href=image.file.url)
                          img(src=image.file.url, height="100px")
                else
                  p.text-sm.text-muted(style="padding: 0 5px") No se reportaron imágenes.
      else if answer.damages && answer.damages.parts
        p.text-muted(style="padding: 5px") - No se reportaron daños.

      if selectChoice && selectChoice.requireAccesories && answer.accessories && answer.accessories.items.length
        .row(style="margin-top:10px")
          .col-md-12
            .p-2
              p.text-muted
                strong #{answer.accessories.question}
              each item in items
                p.text-primary
                  strong - #{item.item}#{item.amount ? ` (${item.amount})` : ''}

      if ((selectChoice && selectChoice.requireImage) || answer.kind === 'image') && answer.images.length
        .row.images
          each image in answer.images
            .col-md-3.col-sm-4.col-xs-4.text-center
              a.zoom-in(href=image.file.url)
                img(src=image.file.url, height="100px")

      if (answer.kind === 'text' || (selectChoice && selectChoice.requireComment)) && answer.comment
        .row(style="margin-top:10px")
          .col-md-12
            p(style="padding:5px")
              span.text-muted.text-sm Comentario
              br
              strong.text-primary #{answer.comment.toUpperCase()}

      if answer.kind === 'numeric-scale' && answer.score != -1
        .row(style="margin-top:10px")
          .col-md-12
            p(style="padding:5px")
              strong Evaluación:
              span.text-muted #{answer.score} (Del #{answer.minValue} al #{answer.maxValue})

