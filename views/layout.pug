doctype html
html
  head
    meta(charset='utf-8')
    //- link(rel='shortcut icon', class='favicon' href=`${process.env.SITE_URL}/static${getVersionedPath('/images/favicon.ico')}`, type='image/x-icon')
    //- link(rel='icon', class='favicon', href=`${process.env.SITE_URL}/static${getVersionedPath('/images/favicon.ico')}`, type='image/x-icon')
    link(rel='shortcut icon', href='https://www.osa-app.cl/img-osa/logo/favicon-osa.ico')
    meta(http-equiv='X-UA-Compatible', content='IE=edge')
    //- Tell the browser to be responsive to screen width
    meta(content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no', name='viewport')
    //- polyfill.io
    script(src='https://polyfill.io/v3/polyfill.min.js?flags=gated&features=default%2Ces2015%2Ces2016%2Ces2017%2Ces5%2Ces6%2Ces7')
    //- Bootstrap 3.3.7
    link(rel='stylesheet', href=`/static${getVersionedPath('/css/vendor/bootstrap/bootstrap.min.css')}`)
    //- Font Awesome
    link(rel='stylesheet', href=`/static${getVersionedPath('/css/vendor/font-awesome/font-awesome.min.css')}`)
    link(rel='stylesheet', href=`https://fonts.googleapis.com/icon?family=Material+Icons`)
    //- Theme style
    link(rel='stylesheet', href=`/static${getVersionedPath('/theme/dist/css/AdminLTE.min.css')}`)
    //- AdminLTE Skin
    link(rel='stylesheet', href=`/static${getVersionedPath('/theme/dist/css/skins/_all-skins.min.css')}`)
    //- Google Font
    link(rel='stylesheet', href='https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic')
    <!--[if lt IE 9]>
    script(src='https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js')
    script(src='https://oss.maxcdn.com/respond/1.4.2/respond.min.js')
    <![endif]-->
    //- touchspin
    link(rel='stylesheet', href=`/static${getVersionedPath('/css/vendor/bootstrap-touchspin/jquery.bootstrap-touchspin.min.css')}`)
    //- personalized stykes
    link(rel='stylesheet', href=`/static${getVersionedPath('/css/style.css')}`)
    block head
  body.skin-purple.fixed.sidebar-mini
    block content
    .js
      //- link(rel='stylesheet', href=`/static${getVersionedPath('/js/vendor/lightbox/ekko-lightbox.css')}`)
      link(rel='stylesheet', href=`/static${getVersionedPath('/js/vendor/icheck/skins/all.css')}`)
      //- jQuery 3
      script(src=`/static${getVersionedPath('/js/vendor/jquery/jquery.min.js')}`)
      //- moment
      script(src=`/static${getVersionedPath('/js/vendor/moment/moment-with-locales.min.js')}`)
      //- moment-timezone
      script(src=`/static${getVersionedPath('/js/vendor/moment/moment-timezone-with-data.min.js')}`)
      //- React
      script(src=`/static${process.env.ENV == 'production' ? getVersionedPath('/js/vendor/react/react.min.js') : getVersionedPath('/js/vendor/react/react.js')}`)
      script(src=`/static${process.env.ENV == 'production' ? getVersionedPath('/js/vendor/react/react-dom.min.js') : getVersionedPath('/js/vendor/react/react-dom.js')}`)
      //-  Sweetalert
      script(src=`/static${getVersionedPath('/js/vendor/sweetalert/sweetalert.min.js')}`)
      //- Bootstrap 3.3.7
      script(src=`/static${getVersionedPath('/js/vendor/bootstrap/bootstrap.min.js')}`)
      //- echarts
      script(src=`/static${getVersionedPath('/js/vendor/echarts/echarts.min.js')}`)
      //- touchspin
      script(src=`/static${getVersionedPath('/js/vendor/bootstrap-touchspin/jquery.bootstrap-touchspin.min.js')}`)
      //- lighbox
      //- script(src=`/static${getVersionedPath('/js/vendor/lightbox/ekko-lightbox.min.js')}`)
      //- toas
      script(src=`/static${getVersionedPath('/js/vendor/toast/toast.js')}`)
      //- socket io
      script(src=`/socket.io/socket.io.js`)
      //- js app
      block js

