doctype html
html
  head
    meta(charset='utf-8')
    link(rel='shortcut icon', href='https://www.osa-app.cl/img-osa/logo/favicon-osa.ico')
    meta(http-equiv='X-UA-Compatible', content='IE=edge')
    //- Tell the browser to be responsive to screen width
    meta(content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no', name='viewport')
    //- Bootstrap 3.3.7
    link(rel='stylesheet', href=`/static${getVersionedPath('/css/vendor/bootstrap/bootstrap.min.css')}`)
    //- Font Awesome
    link(rel='stylesheet', href=`/static${getVersionedPath('/css/vendor/font-awesome/font-awesome.min.css')}`)
    //- Theme style
    link(rel='stylesheet', href=`/static${getVersionedPath('/theme/dist/css/AdminLTE.min.css')}`)
    //- AdminLTE Skin
    link(rel='stylesheet', href=`/static${getVersionedPath('/theme/dist/css/skins/_all-skins.min.css')}`)
    //- Google Font
    link(rel='stylesheet', href='https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic')
    <!--[if lt IE 9]>
    script(src='https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js')
    script(src='https://oss.maxcdn.com/respond/1.4.2/respond.min.js')
    <![endif]-->
    link(rel='stylesheet', href=`/static${getVersionedPath('/css/style.css')}`)
    block head
  block content
  .js
    //- polyfill.io
    script(src='https://cdn.polyfill.io/v2/polyfill.min.js')
    //- jQuery 3
    script(src=`/static${getVersionedPath('/js/vendor/jquery/jquery.min.js')}`)
    //- moment
    script(src=`/static${getVersionedPath('/js/vendor/moment/moment-with-locales.min.js')}`)
    //- React
    script(src=`/static${getVersionedPath('/js/vendor/react/react.js')}`)
    script(src=`/static${getVersionedPath('/js/vendor/react/react-dom.js')}`)
    //-  Sweetalert
    script(src=`/static${getVersionedPath('/js/vendor/sweetalert/sweetalert.min.js')}`)
    //- Bootstrap 3.3.7
    script(src=`/static${getVersionedPath('/js/vendor/bootstrap/bootstrap.min.js')}`)
    //- echarts
    script(src=`/static${getVersionedPath('/js/vendor/echarts/echarts.min.js')}`)
    //- socket io
    script(src=`/socket.io/socket.io.js`)
    //- js app
    block js

