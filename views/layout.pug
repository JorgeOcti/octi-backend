doctype html
html
  head
    meta(charset='utf-8')
    meta(http-equiv='X-UA-Compatible', content='IE=edge')
    //- Tell the browser to be responsive to screen width
    meta(content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no', name='viewport')
    //- Bootstrap 3.3.7
    link(rel='stylesheet', href='/static/theme/bower_components/bootstrap/dist/css/bootstrap.min.css')
    //- Font Awesome
    link(rel='stylesheet', href='/static/theme/bower_components/font-awesome/css/font-awesome.min.css')
    //- Ionicons
    link(rel='stylesheet', href='/static/theme/bower_components/Ionicons/css/ionicons.min.css')
    //- Theme style
    link(rel='stylesheet', href='/static/theme/dist/css/AdminLTE.min.css')
    //- AdminLTE Skin
    link(rel='stylesheet', href='/static/theme/dist/css/skins/_all-skins.min.css')
    //- Google Font
    link(rel='stylesheet', href='https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic')
    block head
  body.hold-transition.skin-purple.sidebar-mini
    block content
    .js
      //- polyfill.io
      script(src='https://cdn.polyfill.io/v2/polyfill.min.js')
      //- jQuery 3
      script(src='/static/theme/bower_components/jquery/dist/jquery.min.js')
      //- moment
      script(src='/static/js/vendor/moment/moment-with-locales.min.js')
      //- React
      //- script(src='/static/js/vendor/react/react-dom.js')
      //- script(src='/static/js/vendor/react/react.js')
      //- Bootstrap 3.3.7
      script(src='/static/theme/bower_components/bootstrap/dist/js/bootstrap.min.js')
      //- SlimScroll
      //- script(src='/static/theme/bower_components/jquery-slimscroll/jquery.slimscroll.min.js')
      //- FastClick
      //- script(src='/static/theme/bower_components/fastclick/lib/fastclick.js')
      //- AdminLTE App
      script(src='/static/theme/dist/js/adminlte.min.js')
      //- AdminLTE for demo purposes
      //- script(src='/static/theme/dist/js/demo.js')
      //- js app
      script(src='/static/js/app/dist/main.js')
