mixin containerDetail(first, second, third, quarter, fifth, sixth)
  tr
    td(width="8%", class="strong")=first
    if second
      td(width="25.3%")=second
    else
      td(width="25.3%")
        .border-bottom-dashed
    if third
      td(width="8%", class="strong")=third
      if quarter
        td(width="25.3%")=quarter
      else
        td(width="25.3%")
          .border-bottom-dashed
    if fifth
      td(width="8%", class="strong")=fifth
      if sixth
        td(width="25.3%")=sixth
      else
        td(width="25.3%")
          .border-bottom-dashed

mixin carResumen(first, second, third, quarter, fifth, sixth)
  tr
    td=first
    td VEHÍCULO
    td=second
    td=third
    td=quarter
    td=fifth
    td=sixth

mixin carDetail(first, second, third, quarter, fifth, sixth)
  tr
    td(width="8%", class="strong")=first
    if second
      td(width="25.3%")=second
    else
      td(width="25.3%")
        .border-bottom-dashed
    if third
      td(width="8%", class="strong")=third
      if quarter
        td(width="25.3%")=quarter
      else
        td(width="25.3%")
          .border-bottom-dashed
    if fifth
      td(width="8%", class="strong")=fifth
      if sixth
        td(width="25.3%")=sixth
      else
        td(width="25.3%")
          .border-bottom-dashed

doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Reporte de Desconsolidado
    style(type="text/css")=css
  body

      header
        .logo
          img(src=user.company.image.url, height="30px")
        .company-info
          h1 !{user.company.businessName} (!{container.venueFound && container.venueFound.abbreviation || ''})
          p Giro: SERVICIOS EXTRAPORTUARIOS
          p Dirección: !{container.venueFound && container.venueFound.code || ''}
          p Emitido por: !{userName} el !{moment().format('DD/MM/YYYY - HH:mm')}
      .section-wrapper
        .section
          .title CONTAINER
          .container-info
            .item
              span.label !{container.car.vin}
            .item
              span.label Fecha Desconsolidado:
              span !{moment(container.updatedAt).format('DD/MM/YYYY - HH:mm')}
            .item
              span.label Cliente:
              span !{container.car.client}
      .section-wrapper
        .section
          .info-grid
            .item
              span.label BL:
              span !{container.extra["N° BL"]}
            .item
              span.label Puerto Origen:
              span !{container.extra["Puerto Origen"]}
            .item
              span.label Nave:
              span !{container.extra["Nave"]}
            .item
              span.label Peso:
              span !{container.extra["Peso"]}
            .item
              span.label N° Viaje:
              span !{container.extra["N° Viaje"]}
            .item
              span.label Emplazamiento:
              span !{container.extra["Emplazamiento"]}
      .section-wrapper
        .section
          .info-grid
            .item
              span.label Registra Desconsolidado:
              span !{container.inventoriedBy && container.inventoriedBy.firstName || "Sin información"} !{container.inventoriedBy && container.inventoriedBy.lastName || ""}
            .item
              span.label Ubicación:
              span !{container.extra["Ubicación"]}
            .item
              span.label Precinto:
              span !{container.extra["Sello IN"]}
      if container.units.length + cars.length > 0
        .section-wrapper
          .section
            .title Contenidos (!{container.units.length + cars.length})
            table
              thead
                tr
                  th #
                  th Descripción
                  th Daños
                  th Recursos
                  th Responsable
                  th Estado
              tbody
                each unit, index in container.units
                  tr
                    td #{index + 1}.
                    td
                      div #{unit.description}
                      if unit.content && unit.content.length > 0
                        ul
                          each item in unit.content
                            li #{item['descripción']}
                    td #{unit.participant.hasDamages ? 'Con daños' : 'Sin daños'}
                    td
                      each assistance in unit.participant.deliveryInfo.assistance
                        div #{assistance.item} (#{assistance.amount == 0 ? 1 : assistance.amount})
                    td
                      div #{unit.participant.user ? `${unit.participant.user.firstName} ${unit.participant.user.lastName}` : ""}
                    td #{'Encontrado'}
                each car, index in cars
                  tr
                    td #{container.units.length + index + 1}.
                    td
                      div #{car.car.vin}
                      div #{car.car.brand + ' ' + car.car.denomination}
                    td #{car.damages && car.damages.length > 0 ? 'Con daños' : 'Sin daños'}
                    td
                      if car.participant && car.participant.deliveryInfo && car.participant.deliveryInfo.assistance
                        each assistance in car.participant.deliveryInfo.assistance
                          div #{assistance.item} (#{assistance.amount == 0 ? 1 : assistance.amount})
                    td #{car.inventoriedBy ? `${car.inventoriedBy.firstName} ${car.inventoriedBy.lastName}` : ""}
                    td #{car.status}
      .section-wrapper
        .section
          .title Evidencia Fotográfica Container (!{evidences.length} Fotos)
          each image in evidences
            .image-box
              .content
                span !{image.comment || ''}
                img(src=image.file.url, alt="Image")
      if container.units.length + cars.length > 0
        .section-wrapper
          .section
            .title Detalle de Unidades (!{container.units.length + cars.length} Unidades)

        each unit, index in container.units
          .section-wrapper
            .section
              .title UNIDAD
              ul.no-bullet
                li !{unit.description}
                if unit.content && unit.content.length > 0
                  li
                    ul
                      each item in unit.content
                        li !{item['descripción']}
              if unit.participant && unit.participant.deliveryInfo && unit.participant.deliveryInfo.assistance.length > 0
                .title RECURSOS UTILIZADOS
                ul
                  each assistance in unit.participant.deliveryInfo.assistance
                    li !{assistance.item}: !{assistance.amount == 0 ? 1 : assistance.amount}

              .title Evidencia Fotográfica Unidad (!{unit.images.length} Fotos)
              each image in unit.images
                .image-box
                  img(src=image.file.url, alt="Image")

              if unit.participant && !unit.participant.hasDamages
                .title SIN DAÑOS
              else if unit.participant && unit.participant.hasDamages
                .title DAÑOS
                if unit.participant.deliveryInfo
                  span.comment !{unit.participant.deliveryInfo.damageComment || ''}
                  br
                  each image in unit.participant.deliveryInfo.damageImages
                    .image-box
                      .content
                        img(src=image.file.url, alt="Image")

        hr
      //- .section-wrapper
      //-   .section
      //-     .title Resumen Carga (!{cars.length} Items)
      //-     table
      //-       thead
      //-         tr
      //-           th #
      //-           th Tipo
      //-           th VIN
      //-           th Marca
      //-           th Modelo
      //-           th Responsable
      //-           th Estado
      //-       tbody
      //-         each car, index in cars
      //-           +carResumen(index + 1, car.car.vin, car.car.brand, car.car.denomination , car.inventoriedBy ? `${car.inventoriedBy.firstName} ${car.inventoriedBy.lastName}` : "", car.status)
      each car, index in cars
        .section-wrapper
          .section
            .title CARGA
            .item-info
              .item
                span.label ITEM:
                span #{index + 1}
              .item
                span.label UNIDAD:
                span !{car.car.vin}
              .item
                span.label MARCA:
                span !{car.car.brand}
          .section
            .title Evidencia Fotográfica Unidad (!{car.images.length} Fotos) (!{car.car.vin})
            each image in car.images
              .image-box
                img(src=image.file.url, alt="Image")
                span !{image.comment}

          .section-wrapper
            .section
              if car.damages.length == 0
                .title SIN DAÑOS
              else
                .title DAÑOS (!{car.car.vin})
              each damage, index in car.damages
                .item-info.bottom-margin
                  .item
                    span.label DAÑO:
                    span #{index + 1}
                  if damage.kind
                    .item
                      span.label TIPO:
                      span !{damage.kind.name}
                  if damage.position
                    .item
                      span.label POSICIÓN:
                      span !{damage.position.name}
                  if damage.part
                    .item
                      span.label PARTE:
                      span !{damage.part.name}
                  if damage.severity
                    .item
                      span.label SEVERIDAD:
                      span !{damage.severity}
                  each image in damage.images
                    .image-box
                      img(src=image.file.url, alt="Image")
          hr

      if emptyEvidences.length > 0
        .section
          .title EVIDENCIA CIERRE
          each evidence in emptyEvidences
            .image-box
                img(src=evidence.file.url, alt="Image")
          if(lastEmptyComment.length > 0)
            .title COMENTARIO
            .empty-evidence
              span !{lastEmptyComment[0]}
