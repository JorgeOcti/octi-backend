{
  "verbose": true,
  "watch": [
    "src"
  ],
  "env": {
    "NODE_ENV": "development"
  },
  "execMap": {
    "ts": "node -r ts-node/register"
  },
  "ignore": [
    ".git",
    "node_modules/**/node_modules",
    "node_modules/*",
    "views/*",
    "public/*"
  ],
  "ext": "js,json,ts",
  "delay": "500"
}
