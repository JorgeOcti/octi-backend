# Copy to prod.tfvars and fill in. prod.tfvars is gitignored — never commit it.
#
# Apply with:
#   cd terraform/secrets
#   terraform workspace select prod
#   terraform apply -var-file=envs/prod.tfvars

secret_values = {
  # AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are managed by the main stack
  # (terraform/s3_uploads.tf — IAM user + access key + Secrets Manager).

  SENTRY_DNS = "https://...@sentry.io/..."

  PUSHER_INSTANCE_ID = "..."
  PUHSER_SECRET_KEY  = "..."

  GEMINI_API_KEY = "..."
  MIXPANEL       = "..."
  MAPBOX         = "..."
  SALFA_SOAP     = "..."

  # SECRET_KEY = "..."   # auto-generated when omitted
}
