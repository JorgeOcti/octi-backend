# Copy to dev.tfvars and fill in. dev.tfvars is gitignored — never commit it.
#
# Apply with:
#   cd terraform/secrets
#   terraform workspace select dev
#   terraform apply -var-file=envs/dev.tfvars
#
# Any key omitted from this map gets the placeholder string "REPLACE_ME"
# (except SECRET_KEY, which gets a fresh random 64-char value).

secret_values = {
  # NOTE: AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are NOT here. The main
  # stack provisions a dedicated IAM user (andes-<env>-app-uploads) scoped to
  # the S3 uploads bucket and writes the access key directly to Secrets Manager.
  # All other AWS access (SES, future SDK calls) flows through the ECS task
  # role automatically.

  # Error tracking
  SENTRY_DNS = "https://7cb5eacf6f8249b888468a1b72bd7632:2c442c3a3ab140f58d339f43558df21f@sentry.osacontrol.com/5"

  # Push notifications (Pusher Beams)
  PUSHER_INSTANCE_ID = "a756459f-3070-44e6-bab3-8705c7d39052"
  PUHSER_SECRET_KEY  = "1177BABA413BDE4C299A8150BC188A7CF6921D5065F2CA51C51C804EBC519276" # sic — matches the typo in the app

  # Third-party APIs
  GEMINI_API_KEY = "..."
  MIXPANEL       = "e630fa150983d94427836ecbef282f37"
  MAPBOX         = "pk.eyJ1IjoicmliYXJyYWNsIiwiYSI6ImNqems3dW85bTAwZmUzbnF0a2xubnl5ejUifQ.tfPmGSbHYdh2nMA6Fmxcxw"
  SALFA_SOAP     = "http://wdp.salfa.cl:8440"

  SECRET_KEY = "m9nqdK2tLv3pr9Vu7h4AAE3f68m4Eyy0"   # uncomment only if you want to set it manually.
  #                       # Otherwise generate_secret_key=true auto-creates one.
}

