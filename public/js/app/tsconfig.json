{
    "compilerOptions": {
        "outDir": "dist/",
        "sourceMap": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "allowJs": true,
        "removeComments": true,
        "lib": [
            "es6",
            "es7",
            "dom"
        ],
        "target": "es5",
        "jsx": "react"
    },
    "exclude": [
        "node_modules",
        "dist",
        "scripts",
        "acceptance-tests",
        "webpack",
        "jest"
    ],
    "include": [
        "src/**/*.ts"
    ],
    "types": [
        "typePatches"
    ]
}
